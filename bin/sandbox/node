#!/bin/sh
# Pi's RPC client starts `node`, and on the PATH runner.ts gives it this is what it finds: Pi in the run's sandbox (src/sandbox.ts),
# in a cgroup of its own where RF_SANDBOX_SCOPE says how, with socat offering the server's socket at 127.0.0.1:7000 inside. bwrap
# starts with no environment but PATH, as its PID 1 inside keeps what bwrap started with for any run to read. Its limits on
# processes and threads, and on a file's size, are set inside, where the kernel counts its processes apart from the server's.
exec $RF_SANDBOX_SCOPE env -i PATH="$PATH" bwrap --args 3 -- /usr/bin/prlimit --nproc="$RF_RUN_TASKS" --fsize="$RF_RUN_FILE_BYTES" /bin/sh -c 'socat TCP-LISTEN:7000,bind=127.0.0.1,fork,reuseaddr UNIX-CONNECT:/run/rf/rf.sock 2>/dev/null & exec node --disable-sigusr1 "$@"' sh "$@" 3< "$RF_SANDBOX_ARGS"
