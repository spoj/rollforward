OPENROUTER_API_KEY=
# Exa, for runs' web search and the website check's web-search tool; without it, neither searches.
# EXA_API_KEY=
# RF_MODEL=openrouter/anthropic/claude-opus-5.5

# Sign in with Microsoft, through an app registered in Microsoft Entra ID, for your organisation's accounts: the server needs
# RF_OIDC_ISSUER, RF_OIDC_CLIENT_ID and RF_PUBLIC_URL to start.
# RF_OIDC_ISSUER=https://login.microsoftonline.com/<tenant id>/v2.0
# RF_OIDC_CLIENT_ID=
# RF_PUBLIC_URL=https://rollforward.example.com
# The redirect exactly as the app registers it (default RF_PUBLIC_URL/auth/callback; the site's root works too)
# RF_OIDC_REDIRECT_URI=https://rollforward.example.com
# A Web app: its client secret. A public client (Mobile and desktop) has none.
# RF_OIDC_CLIENT_SECRET=
# The same app gives each person's Microsoft 365 login: grant it the delegated Graph permissions Mail.Read, Mail.Read.Shared,
# Files.Read.All, Sites.Read.All and offline_access, with admin consent. RF_M365_SCOPES narrows what logins ask for, such as mail alone;
# a ReadWrite permission the tenant granted, such as Mail.ReadWrite, counts for its Read one (the server only reads).
# RF_M365_SCOPES=Mail.Read Mail.Read.Shared Files.Read.All Sites.Read.All
# RF_ADMINS=you@example.com
# RF_ALLOWED_DOMAINS=example.com
# RF_AUTO_PROVISION=1
# RF_SESSION_HOURS=12
# Sign-in's scopes. Entra groups reach the ID token through the app's token configuration (a groups claim), not a scope.
# RF_OIDC_SCOPES=openid profile email

# The browser service (spoj/rollforward-browser), where websites' browsers run: its address, http(s) and on this host or one of
# its own, and this server's client key (its BROWSER_KEY, or an entry in BROWSER_KEYS).
# RF_BROWSER_URL=http://127.0.0.1:8797
# RF_BROWSER_KEY=
# Website and VPN sign-ins: seconds in the person's open browser, with a countdown; runs stay on the checked hosts.
# RF_SIGNIN_S=600

# Optional per-deployment tunnel service (spoj/rollforward-tunnel), for the Fortinet SAML VPN trial.
# Without RF_TUNNEL_URL the feature is absent; rf can vpn EMAIL|GROUP,... must opt people in, even admins.
# API address and service key as reached from this server; CONNECT proxy address as reached from the browser host.
# Encrypt both links (docs/deploy.md); a TLS frontend for the proxy must support HTTP CONNECT.
# RF_TUNNEL_URL=https://tunnel.internal
# RF_TUNNEL_KEY=
# RF_TUNNEL_PROXY=https://tunnel-proxy.internal

# Skills take "today" as this day instead, for a test against a day the systems have data for.
# Remove it in production. Vendor portals ignore it: they show what they hold now.
# RF_TODAY=2026-10-20

# Runs: at most this many at once, each stopped after RF_LIMIT_MIN minutes; Pi's thinking level, and more Pi arguments as JSON.
# RF_MAX_RUNS=20
# RF_MIN_FREE_GB=6
# RF_LIMIT_MIN=120
# RF_THINKING=high
# RF_PI_ARGS=[]
# RF_HOST=127.0.0.1
# The page's theme: default, or the absolute path of a theme's .css file outside the checkout, its logo beside it (docs/design.md).
# RF_THEME=default
# Each run's HOME and /tmp, and the server's socket for runs; folders runs may read besides; the command giving each run its cgroup.
# RF_SCRATCH=/tmp/rollforward
# RF_SANDBOX_RO=
# RF_SANDBOX_SCOPE=
